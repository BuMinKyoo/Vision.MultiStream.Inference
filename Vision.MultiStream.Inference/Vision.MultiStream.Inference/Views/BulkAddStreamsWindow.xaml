<Window x:Class="Vision.MultiStream.Inference.Views.BulkAddStreamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="스트림 일괄 추가"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,6"
                   Text="RTSP URL을 한 줄에 하나씩 붙여넣으세요. 빈 줄은 무시됩니다."/>

        <TextBox Grid.Row="1" x:Name="UrlsTextBox"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"/>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="추론 디바이스:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="CpuRadio" Content="CPU" GroupName="Device" IsChecked="True"
                             VerticalAlignment="Center"/>
                <RadioButton x:Name="DmlRadio" Content="DirectML" GroupName="Device" Margin="8,0,0,0"
                             VerticalAlignment="Center"/>
                <RadioButton x:Name="GpuRadio" Content="CUDA" GroupName="Device" Margin="8,0,0,0"
                             VerticalAlignment="Center"/>
                <RadioButton x:Name="TensorRtRadio" Content="TensorRT" GroupName="Device" Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             ToolTip="NVIDIA TensorRT EP (FP16 + 엔진 캐시)"/>
                <RadioButton x:Name="TensorRtCudaPreRadio" Content="CUDA전후처리+TRT" GroupName="Device" Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             ToolTip="전처리+후처리 CUDA 커널 + TensorRT 추론"/>
                <RadioButton x:Name="NativeCppRadio" Content="GPU(C++)" GroupName="Device" Margin="8,0,0,0"
                             VerticalAlignment="Center"/>
                <CheckBox x:Name="InferenceCheck" Content="추론 사용" IsChecked="True"
                          Margin="16,0,0,0" VerticalAlignment="Center"
                          ToolTip="추가된 스트림에서 YOLO 추론 루프를 켜둘지 여부"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="디코딩:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="DecodeSwRadio" Content="SW" GroupName="DecodeMode" IsChecked="True"
                             VerticalAlignment="Center" Checked="OnDecodeModeChanged"
                             ToolTip="CPU(FFmpeg) 소프트웨어 디코딩"/>
                <RadioButton x:Name="DecodeHwRadio" Content="HW" GroupName="DecodeMode" Margin="8,0,0,0"
                             VerticalAlignment="Center" Checked="OnDecodeModeChanged"
                             ToolTip="GPU(D3D11VA) 하드웨어 디코딩 — 현재 컴포지터 표시기만 가능"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="표시기:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="DisplayBitmapRadio" Content="개별(비트맵)" GroupName="DisplayMode"
                             VerticalAlignment="Center"
                             ToolTip="스트림별 WriteableBitmap 에 CPU 로 그리기 (D3D 를 쓸 수 없는 PC 용)"/>
                <RadioButton x:Name="DisplayD3DRadio" Content="개별(D3D)" GroupName="DisplayMode" IsChecked="True" Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             ToolTip="스트림별 D3D9 셰이더로 표시"/>
                <RadioButton x:Name="DisplayCompositorRadio" Content="컴포지터" GroupName="DisplayMode" Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             ToolTip="단일 컴포지터가 전 스트림을 합성"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="취소" Width="80" Height="30" IsCancel="True" Click="OnCancel"/>
            <Button Content="추가" Width="80" Height="30" Margin="8,0,0,0" IsDefault="True" Click="OnAdd"/>
        </StackPanel>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- FFmpeg.AutoGen 의 P/Invoke 결과 포인터 직접 다루기 위해 필요 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- FFmpeg native DLL 이 x64 라 .NET 호스트도 x64 강제. Platforms 제한은 IDE 디버그 launch 호환을 위해 두지 않음. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    ORT 실행 공급자(EP) 토글. DirectML 패키지와 Gpu(CUDA/TensorRT) 패키지는 같은 onnxruntime.dll 을
    서로 다른 빌드로 들고 와서 한 빌드에 공존할 수 없다. 그래서 이 값 하나로 패키지 + 컴파일 심볼을 함께 전환한다.
      true  → DirectML 패키지 + USE_DIRECTML 심볼  (사용 가능: CPU, DML, NativeCpp(C++))
      false → Gpu 패키지                            (사용 가능: CPU, CUDA, TensorRT)
    NativeCpp(vision_infer.dll)는 ORT+DirectML 로 빌드되므로 DirectML 구성에서만 동작 → EnableNativeInfer 도 함께 켠다.
  -->
  <PropertyGroup>
    <UseDirectML>false</UseDirectML>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseDirectML)'=='true'">
    <DefineConstants>$(DefineConstants);USE_DIRECTML</DefineConstants>
    <EnableNativeInfer>true</EnableNativeInfer>
  </PropertyGroup>
  <!--
    Phase 4 CUDA 네이티브 DLL(vision_cuda.dll)은 순수 CUDA(ORT 무관)라 Gpu 빌드(UseDirectML=false)에서 켠다.
    DirectML 빌드에서는 CUDA 경로를 안 쓰므로 스킵.
  -->
  <PropertyGroup Condition="'$(UseDirectML)'!='true'">
    <EnableCudaInfer>true</EnableCudaInfer>
  </PropertyGroup>

  <ItemGroup>
    <!-- ORT 실행 공급자 패키지: UseDirectML 값에 따라 자동 선택 (위 PropertyGroup 참고). -->
    <!-- GeneratePathProperty: 네이티브 빌드에 ORT 헤더/lib 경로($(PkgMicrosoft_ML_OnnxRuntime_DirectML))를 넘기기 위함 -->
    <PackageReference Condition="'$(UseDirectML)'=='true'" Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" GeneratePathProperty="true" />
    <PackageReference Condition="'$(UseDirectML)'!='true'" Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.16.2" />

    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />

    <!-- RTSP 비디오/오디오 디코딩용 FFmpeg.AutoGen (FFmpeg 8.x 바인딩) -->
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <!-- 디코딩한 PCM 을 스피커로 출력 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Models\yolov8n.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Models\yolov8n_fp16.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- QDQ INT8 모델(tools/quantize_int8.py 생성). CPU/DML INT8 용. TensorRT 는 구버전 TRT 의
         Q/DQ shape inference 빌드 실패로 이 파일 대신 calibration.flatbuffers(A 방식) 사용. -->
    <None Update="Assets\Models\yolov8n_int8.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- TensorRT INT8(Approach A) 캘리브레이션 테이블. FP32 모델 + 이 테이블로 TRT 가 내부 INT8 변환.
         (tools/make_calib_table.py 로 생성) -->
    <None Update="Assets\Models\calibration.flatbuffers">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    FFmpeg 네이티브 DLL 들을 출력 폴더(bin\$(Configuration)\net10.0-windows\)로 복사.
    FFmpegLibraryLoader 가 시작 시 av_register_all 등을 호출하기 전에
    av_set_dll_directory 로 이 폴더를 잡아 준다.
  -->
  <ItemGroup>
    <None Include="Native\win-x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!--
    Phase 3 "GPU(C++)": 네이티브 추론 DLL(vision_infer.dll) 자동 빌드 + 출력 폴더 복사.
    C++ 프로젝트는 .NET SDK(dotnet)로 빌드할 수 없으므로, vswhere 로 VS 정식 MSBuild.exe 를
    찾아 .vcxproj 를 x64 로 Exec 빌드한 뒤 산출 DLL 을 C# 출력 폴더로 복사한다.
    (dotnet build / Visual Studio 솔루션 빌드 양쪽 모두에서 동작)
  -->
  <!--
    네이티브 DLL 은 ORT+DirectML 전제이므로 EnableNativeInfer 는 UseDirectML=true 구성에서만 자동으로 켜진다(위 PropertyGroup).
    Gpu(CUDA) 구성에서는 EnableNativeInfer 가 비정의(=빈 값) → 아래 두 타깃이 스킵된다.
  -->
  <PropertyGroup>
    <NativeInferProj>$(MSBuildThisFileDirectory)..\Native\Vision.MultiStream.Native\Vision.MultiStream.Native.vcxproj</NativeInferProj>
    <NativeInferDll>$(MSBuildThisFileDirectory)..\Native\Vision.MultiStream.Native\x64\$(Configuration)\vision_infer.dll</NativeInferDll>
  </PropertyGroup>

  <Target Name="BuildNativeInferDll" BeforeTargets="BeforeBuild" Condition="'$(EnableNativeInfer)'=='true'">
    <!--
      vswhere 경로의 property function 은 '타깃 안'에서만 평가한다.
      최상위 PropertyGroup 에 두면 VS 가 프로젝트를 '로드'하는 시점에 평가하다 실패해
      프로젝트가 언로드될 수 있다. 타깃 내부는 빌드 시점에만 평가된다.
    -->
    <PropertyGroup>
      <VsWhereExe>$([System.Environment]::GetEnvironmentVariable('ProgramFiles(x86)'))\Microsoft Visual Studio\Installer\vswhere.exe</VsWhereExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(VsWhereExe)')"
           Text="vswhere.exe 를 찾을 수 없습니다(VS C++ 빌드 도구 필요): $(VsWhereExe)" />
    <Exec Command="&quot;$(VsWhereExe)&quot; -latest -requires Microsoft.Component.MSBuild -find MSBuild\**\Bin\MSBuild.exe"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsMsBuildExe" />
    </Exec>
    <Error Condition="'$(VsMsBuildExe)'==''"
           Text="VS MSBuild.exe 를 찾을 수 없습니다. Visual Studio C++ 워크로드를 설치하세요." />
    <Message Importance="high" Text="[Phase3] 네이티브 추론 DLL 빌드: $(NativeInferProj) ($(Configuration)|x64)" />
    <Exec Command="&quot;$(VsMsBuildExe)&quot; &quot;$(NativeInferProj)&quot; /p:Configuration=$(Configuration) /p:Platform=x64 /p:OnnxRuntimeDir=&quot;$(PkgMicrosoft_ML_OnnxRuntime_DirectML)&quot; /v:minimal /nologo" />
  </Target>

  <Target Name="CopyNativeInferDll" AfterTargets="Build" DependsOnTargets="BuildNativeInferDll" Condition="'$(EnableNativeInfer)'=='true'">
    <Error Condition="!Exists('$(NativeInferDll)')"
           Text="네이티브 DLL 이 생성되지 않았습니다: $(NativeInferDll)" />
    <Copy SourceFiles="$(NativeInferDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Phase 4 CUDA: vision_cuda.dll 자동 빌드 + 출력 폴더 복사 (Gpu 빌드 전용).
    .vcxproj 가 CUDA 12.9 build customization + sm_61 로 nvcc 를 돌려 DLL 을 만든다.
    ORT 무관이므로 OnnxRuntimeDir 같은 파라미터는 넘기지 않는다.
  -->
  <PropertyGroup>
    <!-- CUDA DLL 은 성능이 목적이라 C# 구성과 무관하게 항상 Release(-O3, 디버그 -G 없음)로 빌드한다.
         Debug(-G)는 커널 최적화를 꺼서 수 배~10배 느려지므로 성능 측정/실사용에 부적합. -->
    <CudaConfiguration>Release</CudaConfiguration>
    <CudaInferProj>$(MSBuildThisFileDirectory)..\Native\Vision.MultiStream.Cuda\Vision.MultiStream.Cuda.vcxproj</CudaInferProj>
    <CudaInferDll>$(MSBuildThisFileDirectory)..\Native\Vision.MultiStream.Cuda\x64\$(CudaConfiguration)\vision_cuda.dll</CudaInferDll>
  </PropertyGroup>

  <Target Name="BuildCudaInferDll" BeforeTargets="BeforeBuild" Condition="'$(EnableCudaInfer)'=='true'">
    <PropertyGroup>
      <VsWhereExe>$([System.Environment]::GetEnvironmentVariable('ProgramFiles(x86)'))\Microsoft Visual Studio\Installer\vswhere.exe</VsWhereExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(VsWhereExe)')"
           Text="vswhere.exe 를 찾을 수 없습니다(VS C++ 빌드 도구 필요): $(VsWhereExe)" />
    <Exec Command="&quot;$(VsWhereExe)&quot; -latest -requires Microsoft.Component.MSBuild -find MSBuild\**\Bin\MSBuild.exe"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsMsBuildExe" />
    </Exec>
    <Error Condition="'$(VsMsBuildExe)'==''"
           Text="VS MSBuild.exe 를 찾을 수 없습니다. Visual Studio C++ 워크로드를 설치하세요." />
    <Message Importance="high" Text="[Phase4] CUDA 추론 DLL 빌드: $(CudaInferProj) ($(CudaConfiguration)|x64)" />
    <Exec Command="&quot;$(VsMsBuildExe)&quot; &quot;$(CudaInferProj)&quot; /p:Configuration=$(CudaConfiguration) /p:Platform=x64 /v:minimal /nologo" />
  </Target>

  <Target Name="CopyCudaInferDll" AfterTargets="Build" DependsOnTargets="BuildCudaInferDll" Condition="'$(EnableCudaInfer)'=='true'">
    <Error Condition="!Exists('$(CudaInferDll)')"
           Text="CUDA DLL 이 생성되지 않았습니다: $(CudaInferDll)" />
    <Copy SourceFiles="$(CudaInferDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

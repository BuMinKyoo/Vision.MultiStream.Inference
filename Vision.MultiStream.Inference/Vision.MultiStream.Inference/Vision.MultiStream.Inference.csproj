<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- FFmpeg.AutoGen 의 P/Invoke 결과 포인터 직접 다루기 위해 필요 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- FFmpeg native DLL 이 x64 라 .NET 호스트도 x64 강제. Platforms 제한은 IDE 디버그 launch 호환을 위해 두지 않음. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- CUDA로 전환하려면 아래 항목을 주석 처리하고 Microsoft.ML.OnnxRuntime.Gpu 로 교체 -->
    <!-- GeneratePathProperty: 네이티브 빌드에 ORT 헤더/lib 경로($(PkgMicrosoft_ML_OnnxRuntime_DirectML))를 넘기기 위함 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" GeneratePathProperty="true" />
	<!--<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.16.2" />-->

    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />

    <!-- RTSP 비디오/오디오 디코딩용 FFmpeg.AutoGen (FFmpeg 8.x 바인딩) -->
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <!-- 디코딩한 PCM 을 스피커로 출력 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Models\yolov8n.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    FFmpeg 네이티브 DLL 들을 출력 폴더(bin\$(Configuration)\net10.0-windows\)로 복사.
    FFmpegLibraryLoader 가 시작 시 av_register_all 등을 호출하기 전에
    av_set_dll_directory 로 이 폴더를 잡아 준다.
  -->
  <ItemGroup>
    <None Include="Native\win-x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!--
    Phase 3 "GPU(C++)": 네이티브 추론 DLL(vision_infer.dll) 자동 빌드 + 출력 폴더 복사.
    C++ 프로젝트는 .NET SDK(dotnet)로 빌드할 수 없으므로, vswhere 로 VS 정식 MSBuild.exe 를
    찾아 .vcxproj 를 x64 로 Exec 빌드한 뒤 산출 DLL 을 C# 출력 폴더로 복사한다.
    (dotnet build / Visual Studio 솔루션 빌드 양쪽 모두에서 동작)
  -->
  <PropertyGroup>
    <NativeInferProj>$(MSBuildThisFileDirectory)..\Native\Vision.MultiStream.Native\Vision.MultiStream.Native.vcxproj</NativeInferProj>
    <NativeInferDll>$(MSBuildThisFileDirectory)..\Native\Vision.MultiStream.Native\x64\$(Configuration)\vision_infer.dll</NativeInferDll>
  </PropertyGroup>

  <Target Name="BuildNativeInferDll" BeforeTargets="BeforeBuild">
    <!--
      vswhere 경로의 property function 은 '타깃 안'에서만 평가한다.
      최상위 PropertyGroup 에 두면 VS 가 프로젝트를 '로드'하는 시점에 평가하다 실패해
      프로젝트가 언로드될 수 있다. 타깃 내부는 빌드 시점에만 평가된다.
    -->
    <PropertyGroup>
      <VsWhereExe>$([System.Environment]::GetEnvironmentVariable('ProgramFiles(x86)'))\Microsoft Visual Studio\Installer\vswhere.exe</VsWhereExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(VsWhereExe)')"
           Text="vswhere.exe 를 찾을 수 없습니다(VS C++ 빌드 도구 필요): $(VsWhereExe)" />
    <Exec Command="&quot;$(VsWhereExe)&quot; -latest -requires Microsoft.Component.MSBuild -find MSBuild\**\Bin\MSBuild.exe"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="VsMsBuildExe" />
    </Exec>
    <Error Condition="'$(VsMsBuildExe)'==''"
           Text="VS MSBuild.exe 를 찾을 수 없습니다. Visual Studio C++ 워크로드를 설치하세요." />
    <Message Importance="high" Text="[Phase3] 네이티브 추론 DLL 빌드: $(NativeInferProj) ($(Configuration)|x64)" />
    <Exec Command="&quot;$(VsMsBuildExe)&quot; &quot;$(NativeInferProj)&quot; /p:Configuration=$(Configuration) /p:Platform=x64 /p:OnnxRuntimeDir=&quot;$(PkgMicrosoft_ML_OnnxRuntime_DirectML)&quot; /v:minimal /nologo" />
  </Target>

  <Target Name="CopyNativeInferDll" AfterTargets="Build" DependsOnTargets="BuildNativeInferDll">
    <Error Condition="!Exists('$(NativeInferDll)')"
           Text="네이티브 DLL 이 생성되지 않았습니다: $(NativeInferDll)" />
    <Copy SourceFiles="$(NativeInferDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

<Window x:Class="Vision.MultiStream.Inference.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:vm="clr-namespace:Vision.MultiStream.Inference.ViewModels"
        xmlns:models="clr-namespace:Vision.MultiStream.Inference.Models"
        xmlns:common="clr-namespace:Vision.MultiStream.Inference.Common"
        mc:Ignorable="d"
        Title="Vision.MultiStream.Inference (YOLOv8)" Height="800" Width="1280">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <ObjectDataProvider x:Key="LayoutModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:LayoutMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid>
    <DockPanel>
        <!-- 프로세스 성능 상태바 -->
        <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="12,4"
                DataContext="{Binding Performance}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="#88FF88" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center">
                    <Run Text="CPU "/>
                    <Run Text="{Binding CpuPercent, StringFormat={}{0:F1}%, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Foreground="#88CCFF" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Run Text="RAM "/>
                    <Run Text="{Binding MemoryMb, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" MB"/>
                </TextBlock>
                <TextBlock Foreground="#FFAA44" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Run Text="GC  G0:"/>
                    <Run Text="{Binding Gen0, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="  G1:"/>
                    <Run Text="{Binding Gen1, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="  G2:"/>
                    <Run Text="{Binding Gen2, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Foreground="#FF6666" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Run Text="Pause  last:"/>
                    <Run Text="{Binding LastGcPauseMs, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="ms  max:"/>
                    <Run Text="{Binding MaxGcPauseMs, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="ms  count:"/>
                    <Run Text="{Binding PauseCount, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="  total:"/>
                    <Run Text="{Binding TotalPauseMs, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="ms"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <TabControl>
        <!-- ============ RTSP 멀티 스트림 탭 ============ -->
        <TabItem Header="RTSP (다중 스트림)" DataContext="{Binding MultiStream}">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 좌: 사이드 패널 (추가 폼 + 스트림 목록 + 전체제어) -->
                <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Background="#F8F8F8" Margin="0,0,8,0">
                    <DockPanel LastChildFill="True" Margin="8">
                        <!-- 추가 폼 -->
                        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="스트림 추가" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="이름" VerticalAlignment="Center"/>
                                    <TextBox  Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                              Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="URL" VerticalAlignment="Center"/>
                                    <TextBox  Grid.Row="1" Grid.Column="1"
                                              Text="{Binding NewRtspUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="추론:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <RadioButton Content="CPU" IsChecked="{Binding NewUseCpu}" GroupName="NewDevice"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton Content="DML" IsChecked="{Binding NewUseDirectML}" GroupName="NewDevice" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"/>
                                    <RadioButton Content="CUDA" IsChecked="{Binding NewUseGpu}" GroupName="NewDevice" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"/>
                                    <CheckBox Content="추론 사용" IsChecked="{Binding NewUseInference}" Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              ToolTip="추가될 스트림에서 YOLO 추론 루프를 켜둘지 여부"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="디코더:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <RadioButton Content="SW" IsChecked="{Binding NewUseSoftwareDecoding}" GroupName="NewDecoder"
                                                 VerticalAlignment="Center"
                                                 ToolTip="소프트웨어(CPU) 디코딩"/>
                                    <RadioButton Content="HW" IsChecked="{Binding NewUseHardwareDecoding}" GroupName="NewDecoder" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 ToolTip="하드웨어(D3D11VA) 디코딩 — 실패 시 폴백 없이 에러"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="+ 추가" Command="{Binding AddStreamCommand}" Width="80" Height="28"/>
                                    <Button Content="📋 일괄 추가" Command="{Binding AddBulkCommand}" Width="110" Height="28" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 전체 제어 (목록 위쪽 하단) -->
                        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="전체 영상" Margin="0,0,0,2" FontSize="11" Foreground="#555"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🎥 ON" Command="{Binding StartAllVideoCommand}" Width="80" Height="26"/>
                                    <Button Content="🎥 OFF" Command="{Binding StopAllVideoCommand}" Width="80" Height="26" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="전체 소리" Margin="0,6,0,2" FontSize="11" Foreground="#555"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔊 ON" Command="{Binding StartAllAudioCommand}" Width="80" Height="26"/>
                                    <Button Content="🔊 OFF" Command="{Binding StopAllAudioCommand}" Width="80" Height="26" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="전체 추론" Margin="0,6,0,2" FontSize="11" Foreground="#555"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🧠 ON" Command="{Binding StartAllInferenceCommand}" Width="80" Height="26"/>
                                    <Button Content="🧠 OFF" Command="{Binding StopAllInferenceCommand}" Width="80" Height="26" Margin="6,0,0,0"/>
                                </StackPanel>
                                <Button Content="▶ 전체 시작(영상+소리)" Command="{Binding StartAllCommand}" Height="26" Margin="0,6,0,0"
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="⏹ 전체 정지(영상+소리)" Command="{Binding StopAllCommand}" Height="26" Margin="0,4,0,0"
                                        HorizontalAlignment="Stretch"/>
                                <Button Content="✕ 전체 삭제" Command="{Binding RemoveAllCommand}" Height="26" Margin="0,4,0,0"
                                        HorizontalAlignment="Stretch" Foreground="#A00"/>
                                <TextBlock Margin="0,8,0,0" Foreground="#555">
                                    <Run Text="등록:"/>
                                    <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text="개"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 스트림 목록 -->
                        <ListBox ItemsSource="{Binding Streams}" Margin="0,8,0,8"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StreamItemViewModel}">
                                    <Border Padding="4" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold"
                                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                <Border Background="#333" Padding="4,1" CornerRadius="2"
                                                        ToolTip="추론 디바이스">
                                                    <TextBlock Foreground="White" FontSize="10">
                                                        <Run Text="추론:"/>
                                                        <Run Text="{Binding DeviceLabel, Mode=OneWay}" FontWeight="Bold"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="#1E5BAA" Padding="4,1" Margin="4,0,0,0" CornerRadius="2"
                                                        ToolTip="디코더 (SW/HW)">
                                                    <TextBlock Foreground="White" FontSize="10">
                                                        <Run Text="디코더:"/>
                                                        <Run Text="{Binding DecoderLabel, Mode=OneWay}" FontWeight="Bold"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <Ellipse Grid.Row="0" Grid.Column="2" Width="8" Height="8"
                                                     Margin="6,0,0,0" VerticalAlignment="Center"
                                                     Fill="LimeGreen"
                                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding RtspUrl}"/>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <ToggleButton IsChecked="{Binding IsVideoEnabled, Mode=OneWay}"
                                                              Command="{Binding ToggleVideoCommand}"
                                                              Content="🎥" Width="28" Height="22" FontSize="11" Padding="0"
                                                              ToolTip="영상 ON/OFF"/>
                                                <ToggleButton IsChecked="{Binding IsAudioEnabled, Mode=OneWay}"
                                                              Command="{Binding ToggleAudioCommand}"
                                                              Content="🔊" Width="28" Height="22" FontSize="11" Padding="0"
                                                              Margin="4,0,0,0"
                                                              ToolTip="소리 ON/OFF"/>
                                                <ToggleButton IsChecked="{Binding IsInferenceEnabled, Mode=OneWay}"
                                                              Command="{Binding ToggleInferenceCommand}"
                                                              Content="🧠" Width="28" Height="22" FontSize="11" Padding="0"
                                                              Margin="4,0,0,0"
                                                              ToolTip="추론 ON/OFF"/>
                                                <Button Content="▶" Command="{Binding StartCommand}"
                                                        Width="22" Height="22" FontSize="10" Padding="0" Margin="4,0,0,0"
                                                        ToolTip="이 스트림 시작(영상+소리)"/>
                                                <Button Content="⏹" Command="{Binding StopCommand}"
                                                        Width="22" Height="22" FontSize="10" Padding="0" Margin="4,0,0,0"
                                                        ToolTip="이 스트림 정지(영상+소리)"/>
                                                <Button Content="✕" Command="{Binding RemoveCommand}"
                                                        Width="22" Height="22" FontSize="10" Padding="0" Margin="4,0,0,0"
                                                        Foreground="#A00"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 우: 타일 그리드 -->
                <DockPanel Grid.Column="1">
                    <!-- 상단 툴바: 레이아웃 선택 -->
                    <Border DockPanel.Dock="Top" Background="#EEE" Padding="8,4" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="레이아웃:" VerticalAlignment="Center"/>
                            <ComboBox Width="120" Margin="6,0,0,0"
                                      ItemsSource="{Binding Source={StaticResource LayoutModes}}"
                                      SelectedItem="{Binding Layout}"/>
                        </StackPanel>
                    </Border>

                    <!-- 컴포지터 출력(배경) + 셀별 오버레이(앞). 컴포지터가 전 스트림 영상을 한 번에 합성해 그림. -->
                    <Grid>
                        <!-- Source 는 MainWindow.Loaded 에서 컴포지터의 D3DImage 를 직접 대입(디버그 박스와 동일 패턴). -->
                        <Image x:Name="MainCompositorImage" Stretch="Fill"/>

                    <!-- 자동 타일링 그리드 (검출박스/상태/버튼 오버레이만) -->
                    <ItemsControl ItemsSource="{Binding Streams}" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding GridColumns}" Rows="{Binding GridRows}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StreamItemViewModel}">
                                <!-- 정상 경로: 영상은 컴포지터(배경 Image)가 그림 → 셀의 Image 는 Source=null(투명).
                                     폴백 경로(컴포지터 실패 시): 기존 per-stream D3DImageYuvPresenter 가 ImageSource 를
                                     채우면 셀의 Image 가 영상을 그린다. -->
                                <Border BorderBrush="#888" BorderThickness="1" Background="Transparent" Margin="2">
                                    <Grid>
                                        <!-- 영상(폴백용) + 검출 박스. 컴포지터(Stretch=Fill)와 fit 을 맞추려고
                                             Viewbox 도 Fill 사용 → 셀 종횡비가 원본과 달라도 박스가 비디오 픽셀에 정확히 따라붙음. -->
                                        <Viewbox Stretch="Fill">
                                            <Grid Width="{Binding ImageWidth}" Height="{Binding ImageHeight}">
                                                <Image Source="{Binding ImageSource}" Stretch="Fill"/>
                                                <ItemsControl ItemsSource="{Binding Detections}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:Detection}">
                                                            <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                                <Rectangle Stroke="Yellow" StrokeThickness="2"/>
                                                                <Border Background="Yellow" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="2,0">
                                                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="Black">
                                                                        <Run Text="{Binding ClassName, Mode=OneWay}"/>
                                                                        <Run Text=" "/>
                                                                        <Run Text="{Binding Confidence, StringFormat={}{0:P0}, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Viewbox>

                                        <!-- 상단 바: 이름 + 디바이스 + 상태 / 영상/소리 토글 / ✕ -->
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                                Background="#B0000000" Padding="6,2" Margin="4">
                                            <DockPanel LastChildFill="False">
                                                <Button DockPanel.Dock="Right" Content="✕"
                                                        Command="{Binding RemoveCommand}"
                                                        Width="22" Height="22" FontSize="11" Padding="0"
                                                        Background="Transparent" Foreground="White" BorderThickness="0"/>
                                                <Button DockPanel.Dock="Right"
                                                        Content="⏹" Command="{Binding StopCommand}"
                                                        Width="28" Height="22" FontSize="11" Padding="0"
                                                        Background="Transparent" Foreground="White" BorderThickness="0"
                                                        Margin="0,0,4,0"
                                                        ToolTip="이 스트림 정지(영상+소리)"/>
                                                <Button DockPanel.Dock="Right"
                                                        Content="▶" Command="{Binding StartCommand}"
                                                        Width="28" Height="22" FontSize="11" Padding="0"
                                                        Background="Transparent" Foreground="White" BorderThickness="0"
                                                        Margin="0,0,4,0"
                                                        ToolTip="이 스트림 시작(영상+소리)"/>
                                                <ToggleButton DockPanel.Dock="Right"
                                                              IsChecked="{Binding IsInferenceEnabled, Mode=OneWay}"
                                                              Command="{Binding ToggleInferenceCommand}"
                                                              Content="🧠" Width="28" Height="22" FontSize="11" Padding="0"
                                                              Background="Transparent" Foreground="White" BorderThickness="0"
                                                              Margin="0,0,4,0"
                                                              ToolTip="추론 ON/OFF"/>
                                                <ToggleButton DockPanel.Dock="Right"
                                                              IsChecked="{Binding IsAudioEnabled, Mode=OneWay}"
                                                              Command="{Binding ToggleAudioCommand}"
                                                              Content="🔊" Width="28" Height="22" FontSize="11" Padding="0"
                                                              Margin="0,0,4,0"
                                                              ToolTip="소리 ON/OFF"/>
                                                <ToggleButton DockPanel.Dock="Right"
                                                              IsChecked="{Binding IsVideoEnabled, Mode=OneWay}"
                                                              Command="{Binding ToggleVideoCommand}"
                                                              Content="🎥" Width="28" Height="22" FontSize="11" Padding="0"
                                                              Margin="0,0,4,0"
                                                              ToolTip="영상 ON/OFF"/>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"
                                                           DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                <TextBlock Foreground="LightGray"
                                                           DockPanel.Dock="Left" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           ToolTip="추론 디바이스">
                                                    <Run Text="추론:"/>
                                                    <Run Text="{Binding DeviceLabel, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#88CCFF" FontSize="11"
                                                           DockPanel.Dock="Left" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           ToolTip="디코더 (SW/HW)">
                                                    <Run Text="디코더:"/>
                                                    <Run Text="{Binding DecoderLabel, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusMessage}" Foreground="#AAA" FontSize="11"
                                                           DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- 하단 바: FPS (1줄) + 타이밍 (2줄) -->
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                                Background="#B0000000" Padding="6,3" Margin="4">
                                            <StackPanel Orientation="Vertical">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Foreground="LightGreen">
                                                        <Run Text="화면"/>
                                                        <Run Text="{Binding DisplayFps, StringFormat={}{0:F1}, Mode=OneWay}" FontWeight="Bold"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="Yellow" Margin="8,0,0,0">
                                                        <Run Text="추론"/>
                                                        <Run Text="{Binding InferenceFps, StringFormat={}{0:F1}, Mode=OneWay}" FontWeight="Bold"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Foreground="#AAA" FontSize="10" Margin="0,2,0,0">
                                                    <Run Text="전처리"/>
                                                    <Run Text="{Binding PreprocessMs, StringFormat={}{0:F1}ms, Mode=OneWay}"/>
                                                    <Run Text="  추론"/>
                                                    <Run Text="{Binding InferenceMs, StringFormat={}{0:F1}ms, Mode=OneWay}"/>
                                                    <Run Text="  후처리"/>
                                                    <Run Text="{Binding PostprocessMs, StringFormat={}{0:F1}ms, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Foreground="#88CCFF" FontSize="10" Margin="0,2,0,0">
                                                    <Run Text="오디오 fill"/>
                                                    <Run Text="{Binding AudioBufferedMs, Mode=OneWay}"/>
                                                    <Run Text="/"/>
                                                    <Run Text="{Binding AudioBufferLengthMs, Mode=OneWay}"/>
                                                    <Run Text="ms"/>
                                                    <Run Text="  drop"/>
                                                    <Run Text="{Binding AudioDropPercent, StringFormat={}{0:F2}%, Mode=OneWay}"/>
                                                    <Run Text="  drop누적"/>
                                                    <Run Text="{Binding AudioTotalDroppedMs, Mode=OneWay}"/>
                                                    <Run Text="ms"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- 비활성 상태 안내 -->
                                        <TextBlock Text="정지됨 — 🎥 또는 🔊 클릭" Foreground="#888" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ============ 스냅샷 탭 ============ -->
        <TabItem Header="스냅샷 (정적 이미지)" DataContext="{Binding Snapshot}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="이미지 열기..." Command="{Binding LoadImageCommand}" Width="120" Height="32"/>
                    <Button Content="객체 검출" Command="{Binding DetectCommand}" Width="120" Height="32" Margin="8,0,0,0"/>
                    <Button Content="취소" Command="{Binding CancelCommand}" Width="80" Height="32" Margin="8,0,0,0"/>
                    <ProgressBar Width="120" Height="14" Margin="12,0,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding ImagePath}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#888" BorderThickness="1" Background="#222"
                        Margin="0,0,8,0">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="{Binding ImageWidth}" Height="{Binding ImageHeight}">
                            <Image Source="{Binding ImageSource}" Stretch="Fill"/>
                            <ItemsControl ItemsSource="{Binding Detections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Detection}">
                                        <Grid Width="{Binding Width}" Height="{Binding Height}">
                                            <Rectangle Stroke="LimeGreen" StrokeThickness="3"/>
                                            <Border Background="LimeGreen" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="3,1">
                                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="Black">
                                                    <Run Text="{Binding ClassName, Mode=OneWay}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Confidence, StringFormat={}{0:P0}, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                </Border>

                <DockPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="검출 결과" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding Detections}" FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Detection}">
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding ClassName, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Confidence, StringFormat={}{0:P1}, Mode=OneWay}" Foreground="DarkGreen"/>
                                    </TextBlock>
                                    <TextBlock Foreground="Gray">
                                        <Run Text="x="/><Run Text="{Binding X, StringFormat={}{0:F0}, Mode=OneWay}"/>
                                        <Run Text=" y="/><Run Text="{Binding Y, StringFormat={}{0:F0}, Mode=OneWay}"/>
                                        <Run Text=" w="/><Run Text="{Binding Width, StringFormat={}{0:F0}, Mode=OneWay}"/>
                                        <Run Text=" h="/><Run Text="{Binding Height, StringFormat={}{0:F0}, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#EEE" Margin="0,8,0,0" Padding="8,4">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#333"/>
                </Border>
            </Grid>
        </TabItem>

    </TabControl>
    </DockPanel>
    </Grid>
</Window>
